# ============================================================================
# Email Automation Configuration
# ============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (remove .example)
# 2. Fill in your actual values
# 3. NEVER commit .env to Git (it's in .gitignore)
#
# ============================================================================

# Your Gmail address
SENDER_EMAIL=your.email@gmail.com

# Gmail App Password (NOT your regular password!)
# Get it from: https://myaccount.google.com/apppasswords
# Format: 16 characters (e.g., "abcd efgh ijkl mnop")
SENDER_PASSWORD=xxxx xxxx xxxx xxxx

# Friend's email address (who receives the APK)
RECIPIENT_EMAIL=friend.email@gmail.com

# ============================================================================
# SECURITY NOTES:
# ============================================================================
# 
# 1. This is an App Password, NOT your real Gmail password
# 2. App Password only allows sending emails (nothing else)
# 3. You can revoke it anytime at: https://myaccount.google.com/apppasswords
# 4. Never share this file or commit it to Git
# 5. The .env file is automatically ignored by Git
#
# ============================================================================
